# ==============================================================================
# 问窟 GrottoMind 环境变量配置文件示例 (最新 DeepSeek V4 + Cloudflare R2 / CDN 规范)
# ==============================================================================

# ---- 大语言模型 (LLM) 配置 ----
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_MODEL=deepseek-v4-pro

# ---- Embedding 向量模型配置 ----
EMBEDDING_API_BASE=https://api.deepseek.com
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODE=auto

# ---- Cloudflare R2 对象存储与 CDN 加速配置 ----
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=grottomind-assets
# CDN 加速域名 (例如: https://cdn.grottomind.com 或 https://pub-xxxx.r2.dev)
R2_CDN_URL=
# 前端 Vite 静态资源 CDN 前缀 (留空则使用默认降级渲染)
VITE_STORAGE_CDN_URL=

# ---- 前端环境变量 (Vite) ----
VITE_PORT=5180
VITE_AGENT_API=

# ---- FastAPI 后端设置 ----
PORT=8788
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:3000
