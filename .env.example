# ---- Vercel Serverless (Express) 后端 ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PORT=8787

# ---- 前端环境变量 (Vite) ----
# 本地开发固定使用 5180 端口
VITE_PORT=5180
# Python 后端地址，本地开发时留空（由 Vite proxy 转发），生产部署时填写独立服务器地址
# 例如: VITE_AGENT_API=https://grottomind-api.your-domain.com
VITE_AGENT_API=

# ---- Python FastAPI 后端 (server/main.py) ----
GEMINI_API_KEY=
# CORS 白名单（逗号分隔），生产部署时设置为前端域名
# 例如: ALLOWED_ORIGINS=https://grottomind.your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:3000
